# Public local endpoints
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
CHECKOUT_MCP_URL=http://127.0.0.1:8941/mcp
TRUEFORGE_MODEL=openai/gpt-5.6-sol

# Reusable skill source
ONCALL_SKILL_REPOSITORY_URL=
ONCALL_SKILL_REPOSITORY_REF=
ONCALL_SKILL_REPOSITORY_PATH=skills/oncall-runbook
ONCALL_BOOTSTRAP_OUTPUT=.oncall/bootstrap.json
ONCALL_SESSION_STATE=.oncall/session.json
ONCALL_AGENT_NAME=oncall-incident-responder
VITE_ONCALL_AGENT_ID=

# Optional authentication for an OIDC-enabled TrueForge server
TRUEFORGE_TOKEN=

# External providers; supply only in an ignored .env file or secret manager
OPENAI_API_KEY=
DAYTONA_API_KEY=
GITHUB_TOKEN=
GITHUB_DEMO_TOKEN=
SLACK_WEBHOOK_URL=

# Non-secret connector configuration
DAYTONA_SNAPSHOT=
SLACK_CHANNEL=oncall-demo
EVIDENCE_RUN_ID=local
